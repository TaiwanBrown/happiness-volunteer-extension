{
  "manifest_version": 3,
  "name": "Happiness Volunteer",
  "version": "1.0.2",
  "description": "Unofficial support tools for WordPress.com Forum Volunteers",
  "author": "TaiwanBrown",
  "homepage_url": "https://github.com/TaiwanBrown/happiness-volunteer-extension",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Happiness Volunteer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanels/tools.html"
  },
  "permissions": ["sidePanel", "tabs", "storage", "scripting", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true
    }
  ]
}
